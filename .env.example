# Copy to .env.local for local development — never commit secrets.

# REQUIRED: Strong random secret for JWT signing (minimum 64 characters).
LIFTRZ_AUTH_SECRET="generate-a-strong-random-string-at-least-64-characters-long"

# Supabase persistence (required for production / Vercel).
SUPABASE_URL="https://YOUR_PROJECT.supabase.co"
SUPABASE_SERVICE_ROLE_KEY="YOUR_SERVICE_ROLE_KEY"

# OPTIONAL: Restrict CORS to your frontend origin. Leave empty for local dev.
CORS_ORIGIN="https://liftrz.com"

# Email notifications via Resend (https://resend.com)
RESEND_API_KEY="re_xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx"
FROM_EMAIL="Liftrz <hey@liftrz.com>"
